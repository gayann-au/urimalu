# Copy this file to .env and fill in the values for your environment.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Supabase project credentials (Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Identity Services client id for Sign in with Google.
# This value is public (it ships to the browser), so it is safe to commit here.
# It must also be added as an authorised client id on the Google provider in
# Supabase (Authentication -> Providers -> Google).
VITE_GOOGLE_CLIENT_ID=541950730198-68sm6p07dccp9lka6ukh2avkie2r8vfj.apps.googleusercontent.com

# Web Push public VAPID key. Safe to expose to the browser (it identifies the
# app to the push service). Generate a keypair once and paste the PUBLIC half
# here; the PRIVATE half goes ONLY into the Supabase Edge Function secrets,
# never into any committed file.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# AI assistant (Supabase Edge Function "assistant").
# The model provider is chosen by environment variables alone, so switching
# provider needs no code change. These are all SERVER-ONLY secrets. They are NOT
# VITE_ variables and must never ship to the browser or be committed. Set them on
# the deployed function, e.g. `supabase secrets set LLM_API_KEY=...`.
#   LLM_API_KEY   required; the chat-completions key for the provider.
#   LLM_PROVIDER  optional; default "groq".
#   LLM_BASE_URL  optional; API root WITHOUT /chat/completions,
#                 default https://api.groq.com/openai/v1
#   LLM_MODEL     optional; default llama-3.1-8b-instant
#   LLM_MAX_RPM   optional; in-isolate burst limiter, default 25
# The older GROQ_ names still work as fallbacks, so an environment that only has
# GROQ_API_KEY, GROQ_MODEL or GROQ_MAX_RPM set keeps working unchanged.
# Listed here only as documentation; there is nothing to put in the browser .env.
